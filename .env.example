# ===================================================================
# EKKOMI NOCTURNE — PRODUCTION & LOCAL CONFIGURATION
# ===================================================================
# Copy this file to '.env' and fill in your credentials.
# Sensitive: NEVER commit .env to GitHub (already listed in .gitignore).
# ===================================================================

# Target administrator inbox where customer waitlist requests are delivered:
ADMIN_EMAIL=info@ekkomi.co.uk

# -------------------------------------------------------------------
# SECTION 1: PRODUCTION HOSTED BACKEND (Supabase + Resend API)
# -------------------------------------------------------------------
# Required for live Shopify storefront & cloud PostgreSQL database:
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=EKKOMI <notifications@ekkomi.co.uk>

# -------------------------------------------------------------------
# SECTION 2: LOCAL DEVELOPMENT SMTP OPTIONS (For server.py)
# -------------------------------------------------------------------
# OPTION 2A: Google Workspace / Gmail
# Enable 2-Step Verification & create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# OPTION 2B: Domain Webmail / cPanel / Titan / Namecheap / Hostinger
# SMTP_HOST=mail.ekkomi.co.uk
# SMTP_PORT=465
# SMTP_USER=info@ekkomi.co.uk
# SMTP_PASS=YourEmailPasswordHere

# OPTION 2C: Microsoft 365 / Outlook
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=info@ekkomi.co.uk
# SMTP_PASS=YourPasswordHere
